{
  "name": "vscode-web-extension",
  "displayName": "wedbav vscode web extension",
  "description": "description",
  "publisher": "wedbav",
  "version": "0.0.1",
  "private": true,
  "files": [
    "package.nls.json",
    "dist"
  ],
  "engines": {
    "vscode": "1.126.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:webdav"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "1.106",
    "esbuild-loader": "^4.5.0",
    "esbuild-register": "^3.6.0",
    "webpack": "^5.109.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "txml": "^6.0.0"
  }
}
